le\":{\"description\":\"Title of the production\",\"example\":\"Deadpool & Wolverine\",\"type\":\"string\"},\"type\":{\"description\":\"Type of production\",\"example\":\"Movie\",\"type\":\"string\"}},\"required\":[\"id\",\"title\",\"type\",\"release_date\",\"days_until\"],\"type\":\"object\"}}},\"description\":\"Successful response with next Star Wars production details\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message describing what went wrong\",\"type\":\"string\"},\"message\":{\"description\":\"Additional details about the error\",\"type\":\"string\"}},\"required\":[\"error\"],\"type\":\"object\"}}},\"description\":\"No productions found\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message describing what went wrong\",\"type\":\"string\"},\"message\":{\"description\":\"Additional details about the error\",\"type\":\"string\"}},\"required\":[\"error\"],\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
